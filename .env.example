# =============================================================================
# A-Trade Alpaca credentials
#
# ⚠️  PAPER TRADING ONLY — the system hard-codes the Alpaca PAPER endpoint
#     (https://paper-api.alpaca.markets) and will never send a live order.
#
# To enable live paper trading:
#   1. Copy this file to `.env`   (cp .env.example .env)
#   2. Create a free paper account at https://app.alpaca.markets/paper
#   3. Open https://app.alpaca.markets/broker -> Settings -> API Keys
#      (or the "Paper" API key pair in your account dashboard)
#   4. Paste the PAPER key and secret below (without quotes)
#
# Without a .env file the system runs in fully-offline MOCK mode
# (deterministic simulated fills) so you can evaluate it before wiring keys.
# =============================================================================

ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
# Always true; do not change. Live trading is never supported.
ALPACA_PAPER=true

# =============================================================================
# Telegram alerts (OPTIONAL — skip to disable; the agent just stays silent)
#
# 1. Chat with @BotFather on Telegram → /newbot → copy the token it gives you.
# 2. Find your chat id:
#      - open a chat with your bot, send any message, then visit
#        https://api.telegram.org/bot<TOKEN>/getUpdates
#        and copy the "chat":{"id":...} number (can be negative for groups).
# 3. Paste both below. Test with:  python3 -m atrade.cli notify
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
