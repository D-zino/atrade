# A-Trade risk presets — copy one of these into state/config.json
# (or set keys one at a time:  python3 -m atrade.cli config <key> <value>)
#
# Defaults: max_positions 2 · portfolio cap 24% · stop 1.4% · daily loss 3% · drawdown 10%
# All values are per-trade / per-day safety limits — paper money, but the limits
# teach the agent discipline that scales if you ever go bigger.

# ===========================================================================
# PRESET A — Conservative (defaults; lowest risk)
# ===========================================================================
{
  "max_positions": 2,
  "max_position_pct": 0.12,
  "max_portfolio_pct": 0.24,
  "max_trade_value": 20000,
  "intraday_stop_pct": 0.014,
  "daily_loss_limit_pct": 0.03,
  "max_drawdown_pct": 0.10
}

# ===========================================================================
# PRESET B — Balanced (recommended for a meaningful test)
# ===========================================================================
{
  "max_positions": 4,
  "max_position_pct": 0.14,
  "max_portfolio_pct": 0.45,
  "max_trade_value": 50000,
  "intraday_stop_pct": 0.015,
  "daily_loss_limit_pct": 0.03,
  "max_drawdown_pct": 0.12
}

# ===========================================================================
# PRESET C — Aggressive test (open up to 5 positions, wider stops)
# Note: 5 × 15% = 75% is capped by the 60% portfolio cap, so the portfolio
# cap is the binding limit — that's intentional.
# ===========================================================================
{
  "max_positions": 5,
  "max_position_pct": 0.15,
  "max_portfolio_pct": 0.60,
  "max_trade_value": 80000,
  "intraday_stop_pct": 0.02,
  "daily_loss_limit_pct": 0.04,
  "max_drawdown_pct": 0.15
}
